# ==============================================================================
# .gitignore for Sketching EIPE Web Application
# Excludes all files not directly relevant to the web application itself:
#   - Python research, evaluation, and benchmarking scripts & outputs
#   - Ad-hoc / scratch test scripts
#   - AI agents, IDE, and tool configurations
#   - Local development databases & cache files
#   - Build artifacts, dependencies, and environment files
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Next.js & Node.js Build Artifacts & Dependencies
# ------------------------------------------------------------------------------
/node_modules
/.next/
/out/
/build
/dist
/.vercel
/.turbo

# TypeScript & Next build metadata
*.tsbuildinfo
next-env.d.ts

# Package managers & Yarn Berry
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# 2. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env*
!.env.example
*.pem
*.key

# ------------------------------------------------------------------------------
# 3. Databases & Local Storage
# ------------------------------------------------------------------------------
# Local SQLite database files created during development/testing
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/dev.db

# Generated Prisma Client
/src/generated/
/src/generated/prisma

# ------------------------------------------------------------------------------
# 4. Research, Evaluation & Benchmark Scripts (Python)
# ------------------------------------------------------------------------------
# Python scripts used for model evaluations, ablation tests, and pipeline benchmarks
*.py
*.py[cod]
*$py.class
__pycache__/
*.so

# Python environments and test caches
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# ------------------------------------------------------------------------------
# 5. Evaluation Data, Benchmarks & Large Result Logs
# ------------------------------------------------------------------------------
# Output results from evaluation runs
evaluation_results*.json
/zevalresultsbin/
/results/
/eval_results/
/benchmarks/results/

# Log files generated by test runs and server diagnostics
*.log
eval_progress.log
vllm_error.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 6. Ad-Hoc / Scratch / Standalone Test Scripts
# ------------------------------------------------------------------------------
# Root-level ad-hoc testing, model probing, and verification scripts
/run_test.js
/test-*.js
/test_*.js
/test-*.mjs
/test_*.mjs
/list_models.mjs
/test_prompt.js
/test_api.js
/test-gemini.js

# ------------------------------------------------------------------------------
# 7. AI Assistant & Agent Configurations
# ------------------------------------------------------------------------------
# Agent tool configurations, skill installations, and assistant workspaces
/.agents/
/.claude/
/.windsurf/
/.cursor/
/.continue/
/skills-lock.json

# ------------------------------------------------------------------------------
# 8. Editor, IDE & OS Files
# ------------------------------------------------------------------------------
# Operating system metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
