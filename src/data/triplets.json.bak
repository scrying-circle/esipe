    "id": "planar distance",
    "key_idea": "the distance from a point to a plane can be computed by finding the magnitude of the projection of the vector from the origin to the point onto the plane's normal, and comparing it with the distance of the plane to the origin along that normal",
    "description": "PLACEHOLDER - please provide your best evaluation based on their explanation",
    "key_elements": [
      { "element": "point p, depicted as a dot with a line drawn to it from the origin", "role": "represents both the point and the vector from the origin to that point" },
      { "element": "distance d", "role": "the double underline under the d hints that this is the central concept of the sketch. It is the distance from the plane to the point p via the vector normal n to the plane."},
      { "element": "labelled plane", "role": "represents a flat plane in 3D space" },
      { "element": "labelled origin", "role": "functions as the reference point for the the point p and the plane" },
      { "element": "vector n perpedicular from the plane's surface", "role": "the normal vector of the plane. used to compute the perpedicular distance of the point from the origin and comparing this with distance d'"},
      { "element": "distance d'", "role": "It is the perpendicular distance from the origin to the plane."},
      { "element": "dotted line from an unspecified point to p that forms a right angle with the origin (which is labelled with dotted lines and a square angle label) and goes through n", "role": "is labelled as the projection of p onto n, and is the key quantity we need to compute and compare with d' to find d"}
    ],
    "contextual_elements": [
