import { NextResponse } from 'next/server';
import { BedrockRuntimeClient, InvokeModelCommand } from '@aws-sdk/client-bedrock-runtime';

// Use Claude 3.5 Haiku (active model on Bedrock)
const EVAL_MODEL = 'au.anthropic.claude-haiku-4-5-20251001-v1:0';

// Bedrock client automatically uses AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and AWS_REGION from env
const bedrockClient = new BedrockRuntimeClient({ 
  region: process.env.AWS_REGION || 'ap-southeast-2' 
});

// The three conditions for the user study
const CONDITIONS = [
  { id: 'holistic',          label: 'Holistic' },
  { id: 'informed-holistic', label: 'Informed Holistic' },
  { id: 'informed-rubric',   label: 'Informed Rubric' }
];

// --- Shared LLM call helper ---

async function callLLM(prompt) {
  const payload = {
    anthropic_version: "bedrock-2023-05-31",
    max_tokens: 4000,
    messages: [{ role: 'user', content: prompt }]
  };

  const command = new InvokeModelCommand({
    modelId: EVAL_MODEL,
    contentType: "application/json",
    accept: "application/json",
    body: JSON.stringify(payload)
  });

  const response = await bedrockClient.send(command);
  const decodedResponseBody = new TextDecoder().decode(response.body);
  const data = JSON.parse(decodedResponseBody);

  let resultText = data.content?.[0]?.text || '';
  // Strip <think> blocks just in case
  resultText = resultText.replace(/<think>[\s\S]*?<\/think>/gi, '').trim();

  return {
    text: resultText,
    tokens: (data.usage?.input_tokens || 0) + (data.usage?.output_tokens || 0)
  };
}

// --- Shared prompt fragments ---

function groundTruthBlock(keyIdea, keyElements, contextualElements) {
  let block = `<ground_truth>\nKey Idea: "${keyIdea}"\n`;
  
  if (keyElements && keyElements.length > 0) {
    block += `Key Elements in Sketch:\n`;
    keyElements.forEach(item => block += `- ${item.element}: ${item.role}\n`);
    
    if (contextualElements && contextualElements.length > 0) {
      block += `Contextual Elements:\n`;
      contextualElements.forEach(item => block += `- ${item.element}: ${item.role}\n`);
    }
  }
  
  block += `</ground_truth>`;
  return block;
}

function studentBlock(studentDescription) {
  return `<student>
Explanation: "${studentDescription}"
</student>`;
}

const PEDAGOGICAL_CONTEXT = `
<context>
This exercise develops the student's ability to comprehend technical sketches — to identify
visual elements, recognise relationships between them, and synthesise the meaning being
communicated. Your feedback should help them improve this general skill of visual reasoning
and sketch reading, not just arrive at the correct interpretation of this particular sketch.
Guide their observation process and reasoning approach.
</context>`;

const BASE_OUTPUT_INSTRUCTIONS = `
Output Instructions:
1. Return ONLY the raw feedback text. Do NOT use JSON, markdown formatting, or <think> blocks.
2. Keep feedback concise: at most 70 words, addressing the student directly.
3. Structure your feedback as 1-3 connected points with clear logical flow — acknowledge, identify a gap, then suggest a concrete action. Do not raise unrelated points.`;

// ============================================================
// STAGE 1: Structured Extraction (for informed conditions)
// ============================================================

async function extractSegmentation(studentDescription, keyIdea, keyElements, contextualElements) {
  const allElements = [
    ...(keyElements || []).map(e => ({ ...e, type: 'key' })),
    ...(contextualElements || []).map(e => ({ ...e, type: 'contextual' }))
  ];

  const elementList = allElements.map(e => 
    `- ${e.element} [${e.type}] (ground-truth role: "${e.role}")`
  ).join('\n');

  const prompt = `You are a teaching assistant analysing a student's interpretation of a sketch.

${groundTruthBlock(keyIdea, keyElements, contextualElements)}

${studentBlock(studentDescription)}

Your task is to segment the student's explanation and map each segment to the sketch elements it describes.

For each element listed in the ground truth, determine:
1. Whether the student referenced or described it (even indirectly)
2. If yes, extract the relevant portion of their text
3. Whether their stated mechanism/role MATCHES the ground-truth role:
   - "correct": the student's description aligns with the ground-truth role
   - "incorrect": the student described this element but stated a WRONG role or mechanism
   - "vague": the student mentioned it but was too imprecise to judge correctness
   - Use "correct" only if referenced is true

Also determine:
- Whether the student captured the overall Key Idea (the core concept the sketch illustrates)
- Whether the student generalised beyond the sketch to broader context or applications

Elements to check:
${elementList}

Return ONLY valid JSON in this exact format (no markdown fencing, no explanation, no other text):
{
  "groups": [
    {
      "element": "<element name from ground truth>",
      "type": "key|contextual",
      "referenced": true|false,
      "student_text": "<exact quote from student, or null if not referenced>",
      "mechanism": "correct|incorrect|vague"
    }
  ],
  "key_idea_captured": true|false,
  "key_idea_student_text": "<exact quote capturing the key idea, or null>",
  "generalisation_present": true|false,
  "unmatched_student_claims": ["<any student claims not matching any ground-truth element>"]
}`;

  const result = await callLLM(prompt);
  
  // Parse the JSON response
  try {
    // Try to extract JSON even if wrapped in markdown fencing
    let jsonText = result.text;
    const jsonMatch = jsonText.match(/```(?:json)?\s*([\s\S]*?)```/);
    if (jsonMatch) {
      jsonText = jsonMatch[1].trim();
    }
    
    const extraction = JSON.parse(jsonText);
    return { extraction, tokens: result.tokens };
  } catch (e) {
    console.error("Failed to parse extraction JSON:", e, "\nRaw response:", result.text);
    // Return a fallback that won't crash the classifier
    return {
      extraction: {
        groups: (keyElements || []).map(el => ({
          element: el.element,
          type: 'key',
          referenced: false,
          student_text: null,
          mechanism: 'vague'
        })),
        key_idea_captured: false,
        key_idea_student_text: null,
        generalisation_present: false,
        unmatched_student_claims: []
      },
      tokens: result.tokens
    };
  }
}

// ============================================================
// STAGE 2: Deterministic SOLO Classification
// ============================================================

function classifySOLO(extraction) {
  const { groups, key_idea_captured, generalisation_present } = extraction;

  const keyGroups = groups.filter(g => g.type === 'key');

  const correctCount = keyGroups.filter(
    g => g.referenced && (g.mechanism === 'correct' || g.mechanism === 'vague')
  ).length;

  // Key idea is the primary discriminator
  if (key_idea_captured && generalisation_present) {
    return 'extended abstract';
  }

  if (key_idea_captured) {
    return 'relational';
  }

  // Without key idea, fall back to element count
  if (correctCount >= 2) {
    return 'multistructural';
  }

  if (correctCount >= 1) {
    return 'unistructural';
  }

  return 'prestructural';
}

// ============================================================
// STAGE 3: Feedback Prompt Builders
// ============================================================

// --- Holistic (baseline — no extraction, no level naming) ---

function buildHolisticPrompt(studentDescription, keyIdea, keyElements, contextualElements) {
  return `You are a teaching assistant evaluating a student's interpretation of a technical sketch.

${PEDAGOGICAL_CONTEXT}

${groundTruthBlock(keyIdea, keyElements, contextualElements)}

${studentBlock(studentDescription)}

The ground truth is your private reference for understanding the sketch. Use it to assess the student's reasoning, but do NOT reveal its contents — not the key idea, not the element roles, and not the expected relationships. Your job is to guide the student's observation and reasoning process, not to provide the answer or tell them what the sketch means.

If the student has captured the core concept, affirm their reasoning and, if appropriate, suggest how they could sharpen their observation process.

If the student has not captured the core concept, identify the most important gap in their reasoning and suggest a specific observational action they could take (e.g., "look at how element X relates to element Y" or "trace what happens to this feature"). Do not state what they would find — let them discover it.

Do NOT name any rubric level or classification scheme.

${BASE_OUTPUT_INSTRUCTIONS}`;
}

// --- Enriched analysis block builder for informed conditions ---
// NOTE: Element roles from triplet data could be included here for more specific feedback,
// but some role descriptions contain the answer (e.g., "the arrow flips direction").
// If roles are added in the future, sanitise role descriptions in triplets.json first.

function buildEnrichedAnalysis(extraction, classification) {
  const keyGroups = extraction.groups.filter(g => g.type === 'key');
  const contextualGroups = extraction.groups.filter(g => g.type === 'contextual');

  let block = `<analysis>\nElement coverage (key elements):`;

  for (const g of keyGroups) {
    if (g.referenced) {
      block += `\n- ${g.element}: referenced (mechanism: ${g.mechanism})`;
      if (g.student_text) {
        block += `\n  Student said: "${g.student_text}"`;
      }
    } else {
      block += `\n- ${g.element}: not referenced`;
    }
  }

  if (contextualGroups.length > 0) {
    block += `\n\nContextual elements:`;
    for (const g of contextualGroups) {
      block += `\n- ${g.element}: ${g.referenced ? 'referenced' : 'not referenced'}`;
    }
  }

  if (extraction.unmatched_student_claims && extraction.unmatched_student_claims.length > 0) {
    block += `\n\nUnmatched student claims (not in ground truth):`;
    for (const claim of extraction.unmatched_student_claims) {
      block += `\n- "${claim}"`;
    }
  }

  block += `\n\nKey idea captured: ${extraction.key_idea_captured}`;
  block += `\nOverall classification: ${classification}`;
  block += `\n</analysis>`;

  return block;
}

// --- Informed Holistic (extraction-informed, conversational, no level naming) ---

function buildInformedHolisticPrompt(studentDescription, extraction, classification) {
  const analysisBlock = buildEnrichedAnalysis(extraction, classification);

  return `You are a teaching assistant writing feedback on a student's interpretation of a technical sketch.

${PEDAGOGICAL_CONTEXT}

${analysisBlock}

${studentBlock(studentDescription)}

Use the analysis to write targeted feedback that helps the student improve their sketch comprehension skills.

If the student captured the key idea, affirm their reasoning. If their process could be stronger (e.g., they reached the right conclusion but skipped over important visual cues), suggest how they could strengthen their observation approach for future sketches.

If the student has NOT captured the key idea, use the element coverage and their actual statements to identify the most productive gap to address. Suggest a specific observational action tied to what they already noticed — build on their existing understanding rather than pointing out what is missing. If they have misconceptions (see unmatched claims), address the most significant one.

Do NOT name any rubric level, classification scheme, or analysis structure.

${BASE_OUTPUT_INSTRUCTIONS}`;
}

// --- Informed Rubric (extraction-informed, rubric-calibrated) ---

function buildInformedRubricPrompt(studentDescription, extraction, classification) {
  const analysisBlock = buildEnrichedAnalysis(extraction, classification);

  // Map SOLO classification to numbered level
  const levelMap = {
    'prestructural': 1,
    'unistructural': 2,
    'multistructural': 3,
    'relational': 4,
    'extended abstract': 5
  };
  const levelNumber = levelMap[classification] || 1;

  return `You are a teaching assistant writing feedback on a student's interpretation of a technical sketch, using a structured rubric to calibrate your response.

${PEDAGOGICAL_CONTEXT}

<rubric>
- Level 1 of 5: Explanation is off-base or too brief to demonstrate engagement with the sketch.
- Level 2 of 5: Identifies one or two elements in isolation without connecting them.
- Level 3 of 5: Identifies several elements but describes them separately without synthesising their relationships.
- Level 4 of 5: Connects elements into a coherent interpretation with clear reasoning about how they relate.
- Level 5 of 5: Coherent interpretation that also generalises the concept to broader context or applications.
</rubric>

${analysisBlock}

The student has been classified at Level ${levelNumber} of 5.

${studentBlock(studentDescription)}

Use the rubric level and element analysis to calibrate the depth and direction of your feedback, but do NOT mention the level number, rubric, or classification to the student.

If the student is at Level 4+, affirm their reasoning. Optionally suggest how they could refine their observation process or articulate their reasoning more precisely.

If the student is below Level 4, use the element coverage and their actual statements to identify the most productive next step. Suggest a specific observational action tied to what they already noticed. If they have misconceptions (see unmatched claims), address the most significant one. Do not state what they would find — let them discover it.

${BASE_OUTPUT_INSTRUCTIONS}`;
}

// ============================================================
// API Handlers
// ============================================================

export async function GET() {
  return NextResponse.json({ conditions: CONDITIONS, model: EVAL_MODEL });
}

export async function POST(request) {
  try {
    const body = await request.json();
    const { studentDescription, conditionId, keyIdea, keyElements, contextualElements } = body;

    if (!conditionId) {
      return NextResponse.json({ error: "Missing conditionId in request" }, { status: 400 });
    }

    const condition = CONDITIONS.find(c => c.id === conditionId);
    if (!condition) {
      return NextResponse.json({ error: "Invalid conditionId" }, { status: 400 });
    }

    // --- Holistic: single LLM call, no extraction ---
    if (conditionId === 'holistic') {
      const prompt = buildHolisticPrompt(studentDescription, keyIdea, keyElements, contextualElements);
      const result = await callLLM(prompt);

      return NextResponse.json({
        conditionId: condition.id,
        model: EVAL_MODEL,
        grade: 'N/A',
        feedback: result.text,
        tokens: result.tokens
      });
    }

    // --- Informed conditions: extract first, then classify, then generate feedback ---
    const { extraction, tokens: extractionTokens } = await extractSegmentation(
      studentDescription, keyIdea, keyElements, contextualElements
    );
    const classification = classifySOLO(extraction);

    let feedbackPrompt;
    if (conditionId === 'informed-holistic') {
      feedbackPrompt = buildInformedHolisticPrompt(studentDescription, extraction, classification);
    } else if (conditionId === 'informed-rubric') {
      feedbackPrompt = buildInformedRubricPrompt(studentDescription, extraction, classification);
    }

    const feedbackResult = await callLLM(feedbackPrompt);

    return NextResponse.json({
      conditionId: condition.id,
      model: EVAL_MODEL,
      grade: 'N/A',
      feedback: feedbackResult.text,
      classification,
      extraction,
      tokens: extractionTokens + feedbackResult.tokens
    });

  } catch (error) {
    console.error("Error grading:", error);
    return NextResponse.json({ 
      error: "Failed to grade response", 
      details: error.message, 
      stack: error.stack 
    }, { status: 500 });
  }
}
